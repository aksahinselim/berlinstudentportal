# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/student_portal?schema=public"

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_in_prod

# Server Port
PORT=4000

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password-here
MAIL_FROM="Your App Name <your-email@example.com>"

# OTP Configuration
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# FTP Configuration (for file attachments storage)
# Set FTP_HOST to enable FTP storage, otherwise local storage is used
FTP_HOST=
FTP_PORT=21
FTP_USER=anonymous
FTP_PASSWORD=anonymous@
FTP_SECURE=false
FTP_REMOTE_PATH=/uploads
FTP_VERBOSE=false
