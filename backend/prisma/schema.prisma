// Prisma schema for Berlin Student Portal
// Email OTP verification system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Universities table
model University {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  
  users           User[]
  posts           Post[]
  verifications   Verification[]
  userUniversities UserUniversity[]
  
  @@map("universities")
}

// User-University many-to-many relationship
model UserUniversity {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  uniId         Int      @map("uni_id")
  isPrimary     Boolean  @default(false) @map("is_primary")
  status        String   @default("pending") // pending, verified, rejected
  verifiedAt    DateTime? @map("verified_at")
  
  createdAt     DateTime @default(now()) @map("created_at")
  
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university    University @relation(fields: [uniId], references: [id])
  
  @@unique([userId, uniId])
  @@index([userId])
  @@index([uniId])
  @@map("user_universities")
}

// Users with email OTP verification
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  uniId         Int       @map("uni_id")
  status        String    @default("pending") // pending, verified, rejected, deleted
  handle        String?
  isAdmin       Boolean   @default(false) @map("is_admin")
  
  // Email verification fields
  emailVerified Boolean   @default(false) @map("email_verified")
  verifiedAt    DateTime? @map("verified_at")
  
  createdAt     DateTime  @default(now()) @map("created_at")
  
  // Relations
  university       University       @relation(fields: [uniId], references: [id])
  posts            Post[]
  replies          Reply[]
  verifications    Verification[]
  otpRequests      EmailOtp[]
  userUniversities UserUniversity[]
  
  @@index([email])
  @@index([uniId])
  @@map("users")
}

// Email OTP for verification
model EmailOtp {
  id           String   @id @default(uuid())
  userId       Int      @map("user_id")
  
  codeHash     String   @map("code_hash")
  expiresAt    DateTime @map("expires_at")
  attemptCount Int      @default(0) @map("attempt_count")
  maxAttempts  Int      @default(5) @map("max_attempts")
  lastSentAt   DateTime @default(now()) @map("last_sent_at")
  
  createdAt    DateTime @default(now()) @map("created_at")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([expiresAt])
  @@map("email_otps")
}

// Posts table
model Post {
  id           Int      @id @default(autoincrement())
  uniId        Int      @map("uni_id")
  authorId     Int      @map("author_id")
  title        String
  body         String
  tags         String[]
  votes        Int      @default(0)
  repliesCount Int      @default(0) @map("replies_count")
  attachments  Json     @default("[]") // Legacy JSON field for inline attachments
  
  createdAt    DateTime @default(now()) @map("created_at")
  
  university      University   @relation(fields: [uniId], references: [id])
  author          User         @relation(fields: [authorId], references: [id])
  replies         Reply[]
  attachmentFiles Attachment[]
  
  @@index([uniId])
  @@index([authorId])
  @@map("posts")
}

// Replies table
model Reply {
  id              Int      @id @default(autoincrement())
  postId          Int      @map("post_id")
  authorId        Int      @map("author_id")
  body            String
  votes           Int      @default(0)
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  post            Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User         @relation(fields: [authorId], references: [id])
  attachmentFiles Attachment[] // Add relation to attachments
  
  @@index([postId])
  @@index([authorId])
  @@map("replies")
}

// Verifications table
model Verification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  uniId       Int      @map("uni_id")
  selfieUrl   String   @map("selfie_url")
  cardUrl     String   @map("card_url")
  status      String   @default("pending") // pending, approved, rejected
  
  submittedAt DateTime @default(now()) @map("submitted_at")
  
  user        User       @relation(fields: [userId], references: [id])
  university  University @relation(fields: [uniId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@map("verifications")
}

// Attachments table (for file uploads)
model Attachment {
  id           Int      @id @default(autoincrement())
  postId       Int?     @map("post_id")
  replyId      Int?     @map("reply_id")
  filename     String
  originalName String   @map("original_name")
  fileType     String   @map("file_type")
  fileSize     Int      @map("file_size")
  filePath     String   @map("file_path")
  storageType  String   @default("local") @map("storage_type") // 'local', 'ftp', or 's3'
  
  createdAt    DateTime @default(now()) @map("created_at")
  
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply        Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  
  @@index([postId])
  @@index([replyId])
  @@map("attachments")
}

